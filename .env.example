# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (local dev, preview builds).
NEXT_PUBLIC_GA_ID=

# Canonical site URL — used by sitemap.xml, robots.txt, and canonical/hreflang tags.
# Set to the staging domain on staging environments if you want sitemap URLs to
# reflect it; harmless to leave as production on staging.
NEXT_PUBLIC_SITE_URL=https://www.kvcglobal.vn

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# MISA native Webforms: no OpenAPI credentials or Sanity write token required.
# Active staff codes: lib/misa-attribution.ts.
# Actual form IDs/keys and canonical .vn origin: lib/misa-webforms.ts (server-only).
