# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (local dev, preview builds).
NEXT_PUBLIC_GA_ID=

# Canonical site URL — used by sitemap.xml, robots.txt, and canonical/hreflang tags.
# Set to the staging domain on staging environments if you want sitemap URLs to
# reflect it; harmless to leave as production on staging.
NEXT_PUBLIC_SITE_URL=https://kvcglobal.com

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# MISA AMIS CRM Open API (Thiết lập → Kết nối → API on AMIS CRM, Professional tier+).
# When unset, lead submissions skip the CRM push and only persist to Sanity.
MISA_CLIENT_ID=
MISA_CLIENT_SECRET=

# Owner assignment: map UTM staff codes to exact MISA owner_name strings
# (format from CRM: "Họ tên (Mã NV)"), plus fallback owner for unmapped leads.
# JSON array; update without redeploy:
# MISA_STAFF_MAP=[{"code":"NV01","owner":"Nguyễn Văn A (NV000001)"}]
MISA_STAFF_MAP=
MISA_DEFAULT_OWNER=
